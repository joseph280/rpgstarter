# =============================================================================
# .gitattributes — RPGStarter: The Convergence (Unity 6 + URP)
# =============================================================================
# Tells Git two things:
#   1. Which files to route through LFS (Large File Storage)
#   2. How to handle line endings on text files across Windows/Mac/Linux
#
# LFS is REQUIRED before any binary art asset is committed.
# Setup: install Git LFS once per machine (`git lfs install`), then commit
# this file. Files matching the patterns below will auto-route to LFS.
# =============================================================================


# ---------- Default text handling ----------
# 'text=auto' lets Git decide. Combined with 'eol=lf' below for code,
# this normalizes line endings so Windows/Mac/Linux devs don't fight Git.
* text=auto


# ---------- Source code: force LF line endings ----------
*.cs        text eol=lf
*.shader    text eol=lf
*.compute   text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.hlslinc   text eol=lf
*.uss       text eol=lf
*.uxml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.txt       text eol=lf
*.gitignore text eol=lf


# ---------- Unity YAML files ----------
# Scenes, prefabs, ScriptableObject assets, materials, etc. are YAML text.
# Unity provides custom merge tools for these. Mark as binary-like to avoid
# accidental merges that corrupt them.
*.unity     merge=unityyamlmerge eol=lf
*.prefab    merge=unityyamlmerge eol=lf
*.asset     merge=unityyamlmerge eol=lf
*.mat       merge=unityyamlmerge eol=lf
*.anim      merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.meta      merge=unityyamlmerge eol=lf


# =============================================================================
# LFS PATTERNS — binary files routed to Large File Storage
# =============================================================================

# ---------- 3D models ----------
*.fbx       filter=lfs diff=lfs merge=lfs -text
